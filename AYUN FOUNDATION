<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AYUN Foundation - Planting Hope, Growing Future</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-green: #2d5016;
            --light-green: #5a9216;
            --accent-green: #8bc34a;
            --earth-brown: #5d4037;
            --sky-blue: #87ceeb;
            --white: #ffffff;
            --text-dark: #1a1a1a;
        }

        body {
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
            background: linear-gradient(to bottom, #87ceeb 0%, #e8f5e9 100%);
        }

        /* 3D Scene Container */
        .scene-3d {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            perspective: 1000px;
            overflow: hidden;
        }

        .floating-tree {
            position: absolute;
            width: 60px;
            height: 100px;
            transform-style: preserve-3d;
            animation: float 6s ease-in-out infinite;
        }

        .floating-tree:nth-child(1) {
            top: 10%;
            left: 10%;
            animation-delay: 0s;
        }

        .floating-tree:nth-child(2) {
            top: 20%;
            right: 15%;
            animation-delay: 1s;
        }

        .floating-tree:nth-child(3) {
            bottom: 20%;
            left: 5%;
            animation-delay: 2s;
        }

        .floating-tree:nth-child(4) {
            bottom: 30%;
            right: 10%;
            animation-delay: 3s;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0) rotateY(0deg);
            }
            50% {
                transform: translateY(-20px) rotateY(180deg);
            }
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 50px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            transition: all 0.3s ease;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-green);
            text-decoration: none;
            transform-style: preserve-3d;
            transition: transform 0.3s ease;
        }

        .logo:hover {
            transform: rotateY(10deg) scale(1.05);
        }

        .logo i {
            font-size: 32px;
            margin-right: 10px;
            color: var(--light-green);
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent-green);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Hero Section */
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .hero-content {
            text-align: center;
            z-index: 2;
            transform-style: preserve-3d;
            animation: heroFloat 3s ease-in-out infinite;
        }

        @keyframes heroFloat {
            0%, 100% {
                transform: translateY(0) rotateX(0deg);
            }
            50% {
                transform: translateY(-10px) rotateX(2deg);
            }
        }

        .hero h1 {
            font-size: 4rem;
            color: var(--primary-green);
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
            transform: translateZ(50px);
        }

        .hero p {
            font-size: 1.5rem;
            color: var(--text-dark);
            margin-bottom: 30px;
            transform: translateZ(30px);
        }

        .cta-button {
            display: inline-block;
            padding: 15px 40px;
            background: linear-gradient(135deg, var(--light-green), var(--accent-green));
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.1rem;
            transform: translateZ(40px);
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(139, 195, 74, 0.3);
        }

        .cta-button:hover {
            transform: translateZ(60px) translateY(-5px);
            box-shadow: 0 15px 40px rgba(139, 195, 74, 0.4);
        }

        /* 3D Trees in Hero */
        .tree-3d {
            position: absolute;
            width: 200px;
            height: 300px;
            transform-style: preserve-3d;
        }

        .tree-3d.left {
            left: 10%;
            bottom: 10%;
            animation: rotateTree 20s linear infinite;
        }

        .tree-3d.right {
            right: 10%;
            bottom: 10%;
            animation: rotateTree 20s linear infinite reverse;
        }

        @keyframes rotateTree {
            0% {
                transform: rotateY(0deg);
            }
            100% {
                transform: rotateY(360deg);
            }
        }

        /* Mission Section */
        .mission {
            padding: 100px 50px;
            background: rgba(255, 255, 255, 0.9);
            position: relative;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            font-size: 3rem;
            color: var(--primary-green);
            margin-bottom: 50px;
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .mission-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }

        .mission-card {
            background: white;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transform-style: preserve-3d;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .mission-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, var(--light-green), var(--accent-green));
        }

        .mission-card:hover {
            transform: translateY(-10px) rotateX(5deg);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .mission-card i {
            font-size: 3rem;
            color: var(--light-green);
            margin-bottom: 20px;
        }

        .mission-card h3 {
            font-size: 1.5rem;
            color: var(--primary-green);
            margin-bottom: 15px;
        }

        /* Impact Counter */
        .impact-section {
            padding: 80px 50px;
            background: linear-gradient(135deg, var(--primary-green), var(--light-green));
            color: white;
            position: relative;
            overflow: hidden;
        }

        .counters {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            text-align: center;
        }

        .counter {
            transform-style: preserve-3d;
            transition: transform 0.3s ease;
        }

        .counter:hover {
            transform: rotateY(10deg) scale(1.05);
        }

        .counter-number {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .counter-label {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Projects Section */
        .projects {
            padding: 100px 50px;
            background: rgba(255, 255, 255, 0.9);
        }

        .project-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
            margin-top: 50px;
        }

        .project-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transform-style: preserve-3d;
            transition: all 0.3s ease;
        }

        .project-card:hover {
            transform: rotateY(5deg) translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .project-image {
            height: 250px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            position: relative;
            overflow: hidden;
        }

        .project-image::after {
            content: '🌳';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 5rem;
            opacity: 0.3;
        }

        .project-content {
            padding: 30px;
        }

        .project-content h3 {
            color: var(--primary-green);
            margin-bottom: 15px;
            font-size: 1.5rem;
        }

        /* Join Section */
        .join-section {
            padding: 100px 50px;
            background: linear-gradient(135deg, rgba(139, 195, 74, 0.1), rgba(93, 64, 55, 0.1));
            text-align: center;
        }

        .join-content {
            max-width: 800px;
            margin: 0 auto;
        }

        .join-content h2 {
            font-size: 2.5rem;
            color: var(--primary-green);
            margin-bottom: 30px;
        }

        .join-form {
            display: flex;
            gap: 20px;
            margin-top: 40px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .join-form input {
            flex: 1;
            min-width: 250px;
            padding: 15px 25px;
            border: 2px solid var(--accent-green);
            border-radius: 50px;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .join-form input:focus {
            border-color: var(--light-green);
            box-shadow: 0 0 0 3px rgba(139, 195, 74, 0.1);
        }

        /* Footer */
        footer {
            background: var(--primary-green);
            color: white;
            padding: 50px;
            text-align: center;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 30px;
        }

        .social-links a {
            color: white;
            font-size: 1.5rem;
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            transform: translateY(-5px) scale(1.2);
            color: var(--accent-green);
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.5rem;
            }

            .hero p {
                font-size: 1.2rem;
            }

            .nav-links {
                display: none;
            }

            .mission-cards {
                grid-template-columns: 1fr;
            }

            .project-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Particle Effect */
        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .particle {
            position: absolute;
            width: 10px;
            height: 10px;
            background: rgba(139, 195, 74, 0.5);
            border-radius: 50%;
            animation: particleFloat 10s linear infinite;
        }

        @keyframes particleFloat {
            0% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateY(-100vh) rotate(360deg);
                opacity: 0;
            }
        }
    </style>
</head>
<body>
    <!-- 3D Scene Background -->
    <div class="scene-3d">
        <div class="floating-tree">🌳</div>
        <div class="floating-tree">🌲</div>
        <div class="floating-tree">🌴</div>
        <div class="floating-tree">🎋</div>
    </div>

    <!-- Particle Effects -->
    <div class="particles" id="particles"></div>

    <!-- Navigation -->
    <nav>
        <div class="nav-container">
            <a href="#" class="logo">
                <i class="fas fa-tree"></i>
                AYUN FOUNDATION
            </a>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#mission">Mission</a></li>
                <li><a href="#impact">Impact</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#join">Join Us</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="tree-3d left">🌳</div>
        <div class="tree-3d right">🌲</div>
        <div class="hero-content">
            <h1>Planting Hope, Growing Future</h1>
            <p>Join AYUN Foundation in our mission to create a greener, sustainable world</p>
            <a href="#join" class="cta-button">Start Planting Today</a>
        </div>
    </section>

    <!-- Mission Section -->
    <section class="mission" id="mission">
        <div class="container">
            <h2 class="section-title">Our Mission</h2>
            <div class="mission-cards">
                <div class="mission-card">
                    <i class="fas fa-seedling"></i>
                    <h3>Plant Trees</h3>
                    <p>We organize and execute plantation drives across communities, transforming barren lands into lush green forests.</p>
                </div>
                <div class="mission-card">
                    <i class="fas fa-users"></i>
                    <h3>Empower Communities</h3>
                    <p>We educate and involve local communities in sustainable practices, creating environmental stewards for the future.</p>
                </div>
                <div class="mission-card">
                    <i class="fas fa-globe-americas"></i>
                    <h3>Restore Ecosystems</h3>
                    <p>Our initiatives focus on restoring natural habitats and biodiversity, ensuring a balanced ecosystem for all species.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Impact Section -->
    <section class="impact-section" id="impact">
        <div class="container">
            <h2 class="section-title" style="color: white;">Our Impact</h2>
            <div class="counters">
                <div class="counter">
                    <div class="counter-number" data-target="50000">5000</div>
                    <div class="counter-label">Trees Planted</div>
                </div>
                <div class="counter">
                    <div class="counter-number" data-target="100">40</div>
                    <div class="counter-label">Communities Reached</div>
                </div>
                <div class="counter">
                    <div class="counter-number" data-target="5000"><div class="editable-hover">50</div></div>
                    <div class="counter-label">Volunteers</div>
                </div>
                <div class="counter">
                    <div class="counter-number" data-target="25">0</div>
                    <div class="counter-label">Hectares Restored</div>
                </div>
                <div class="founder-info" style="grid-column: 1 / -1; margin-top: 20px; text-align: center;">
                    <h3 style="font-size: 1.8rem; margin-bottom: 10px; color: #ffffff;">Founders</h3>
                    <p style="font-size: 1.3rem; color: #e8f5e9;">ANUJA RAY AND AYUSHMAN BEHERA</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section class="projects" id="projects">
        <div class="container">
            <h2 class="section-title">Our Projects</h2>
            <div class="project-grid">
                <div class="project-card">
                    <div class="project-image"></div>
                    <div class="project-content">
                        <h3>Urban Forest Initiative</h3>
                        <p>Transforming urban spaces into green oases, improving air quality and creating recreational spaces for communities.</p>
                    </div>
                </div>
                <div class="project-card">
                    <div class="project-image"></div>
                    <div class="project-content">
                        <h3>Riverbank Restoration</h3>
                        <p>Planting native species along riverbanks to prevent erosion and restore aquatic ecosystems.</p>
                    </div>
                </div>
                <div class="project-card">
                    <div class="project-image"></div>
                    <div class="project-content">
                        <h3>School Green Program</h3>
                        <p>Engaging students in environmental education and creating green spaces in educational institutions.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Join Section -->
    <section class="join-section" id="join">
        <div class="join-content">
            <h2>Join Our Green Movement</h2>
            <p>Be part of the change. Together, we can create a sustainable future for generations to come.</p>
            <form class="join-form" onsubmit="handleSubmit(event)">
                <input type="text" placeholder="Your Name" required="">
                <input type="email" placeholder="Your Email" required="">
                <button type="submit" class="cta-button">Join Now</button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <h3>AYUN FOUNDATION</h3>
            <p>Planting today for a greener tomorrow</p>
            <div class="social-links">
                <a href="#"><i class="fab fa-facebook"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-linkedin"></i></a>
            </div>
            <p style="margin-top: 30px; opacity: 0.8;">© 2026 AYUN Foundation. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Create particles
        function createParticles() {
            const particlesContainer = document.getElementById('particles');
            for (let i = 0; i < 20; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 10 + 's';
                particle.style.animationDuration = (10 + Math.random() * 10) + 's';
                particlesContainer.appendChild(particle);
            }
        }

        // Counter animation
        function animateCounters() {
            const counters = document.querySelectorAll('.counter-number');
            const speed = 200;

            counters.forEach(counter => {
                const animate = () => {
                    const value = +counter.getAttribute('data-target');
                    const data = +counter.innerText;
                    const time = value / speed;

                    if (data < value) {
                        counter.innerText = Math.ceil(data + time);
                        setTimeout(animate, 1);
                    } else {
                        counter.innerText = value.toLocaleString();
                    }
                }
                animate();
            });
        }

        // Intersection Observer for animations
        const observerOptions = {
            threshold: 0.5,
            rootMargin: '0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    if (entry.target.classList.contains('impact-section')) {
                        animateCounters();
                        observer.unobserve(entry.target);
                    }
                }
            });
        }, observerOptions);

        // Observe impact section
        document.addEventListener('DOMContentLoaded', () => {
            createParticles();
            const impactSection = document.querySelector('.impact-section');
            if (impactSection) {
                observer.observe(impactSection);
            }
        });

        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Form submission
        function handleSubmit(event) {
            event.preventDefault();
            alert('Thank you for joining AYUN Foundation! We will contact you soon.');
            event.target.reset();
        }

        // Parallax effect on scroll
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const parallax = document.querySelector('.scene-3d');
            if (parallax) {
                parallax.style.transform = `translateY(${scrolled * 0.5}px)`;
            }
        });

        // 3D tilt effect on cards
        document.querySelectorAll('.mission-card, .project-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 10;
                const rotateY = (centerX - x) / 10;
                
                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(10px)`;
            });
            
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateZ(0)';
            });
        });
    </script>

</body></html>
